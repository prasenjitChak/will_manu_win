# Handed out at the start of the workshop. Revoked at the end. Never commit .env.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5

# Only needed for the Vercel steps (201+). Also provided.
VERCEL_TOKEN=
VERCEL_TEAM=
# Your Vercel project name. Defaults to ws-<your login>-<python|ts>. Set if that collides.
VERCEL_PROJECT=

# Pick your own random strings. They protect the deployed endpoints.
WEBHOOK_SECRET=
CRON_SECRET=
MAX_TURNS=10

# EPL score predictor: free key from football-data.org/client/register
FOOTBALL_DATA_API_KEY=